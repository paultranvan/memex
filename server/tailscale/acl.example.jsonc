// Access rules of the Tailscale network for memex.
// One way only: your devices → the server. No rule has the server as its source,
// so it cannot open any connection to your machines.
{
    "tagOwners": {
        "tag:vps": ["autogroup:admin"]
    },
    "acls": [
        {
            "action": "accept",
            "src": ["autogroup:member"],
            // 22: SSH (memex, administration). Add here the ports of the private
            // services you want to reach, for example 9119 for the Hermes server.
            "dst": ["tag:vps:22"]
        }
    ]
}

[Unit]
Description=memex: curator run (proposes a review)
After=network-online.target

[Service]
Type=oneshot
User=@MEMEX_USER@
Group=@MEMEX_USER@
WorkingDirectory=@MEMEX_HOME@
Environment=HOME=@MEMEX_HOME@
Environment=PATH=@MEMEX_HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@MEMEX_BIN@ server curate
Nice=10
TimeoutStartSec=3600
SuccessExitStatus=1
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@MEMEX_HOME@ @EXTRA_RW@
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
InaccessiblePaths=@DENY@

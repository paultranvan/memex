[Unit]
Description=memex: archivist and weaver run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@MEMEX_USER@
Group=@MEMEX_USER@
WorkingDirectory=@MEMEX_HOME@
Environment=HOME=@MEMEX_HOME@
Environment=PATH=@MEMEX_HOME@/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@MEMEX_BIN@ server run
Nice=10
TimeoutStartSec=3600
# A failed run (agent unavailable, segment rejected) must not mark the unit as failed.
SuccessExitStatus=1
# ── Confinement: the agents write only inside the memex directory ──
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=@MEMEX_HOME@ @EXTRA_RW@
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
InaccessiblePaths=@DENY@

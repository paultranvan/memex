# memex — configuration
#
# One format for the host and for the server: KEY=value lines.
#   host:   ~/.config/memex/memex.env
#   server: /etc/memex/memex.env
# An environment variable of the same name takes precedence over this file.
# Everything is optional: the values below are the defaults.

# ══ Common ═══════════════════════════════════════════════════════════════

# Language of the wiki, used when the wiki is created (en or fr). Afterwards
# the wiki remembers its own language.
MEMEX_LANG=en

# Time zone of the dates written in the wiki (journal, decision records).
MEMEX_TZ=Europe/Paris


# ══ Host: what is captured ═══════════════════════════════════════════════

# Name of this machine in the segments. Default: its hostname.
MEMEX_DEVICE=

# Sources to sweep: claude-code, codex, hermes (comma-separated list).
MEMEX_SOURCES=claude-code,codex

# Where each tool keeps its sessions.
MEMEX_CLAUDE_PROJECTS_DIR=~/.claude/projects
MEMEX_CODEX_SESSIONS_DIR=~/.codex/sessions
MEMEX_HERMES_DB=~/.hermes/state.db
# Hermes sessions to ignore, by origin (scheduled tasks, etc.).
MEMEX_HERMES_EXCLUDE_SOURCES=cron

# A session is swept once it has been idle for this many minutes.
# The end of a Claude Code session triggers an immediate sweep, without waiting.
MEMEX_IDLE_MINUTES=10

# What must never be captured. Comma-separated patterns.
#   MEMEX_EXCLUDE_PATHS:   working directories (path patterns, ~ accepted)
#   MEMEX_EXCLUDE_REMOTES: git repositories, by their remote address
#   MEMEX_INCLUDE_PATHS:   when set, only these directories are captured
# An empty `.memex-ignore` file at the root of a project excludes it too.
# Example: MEMEX_EXCLUDE_PATHS=~/Work,~/dev/work
#          MEMEX_EXCLUDE_REMOTES=*my-employer*,gitlab.company.example/*
MEMEX_EXCLUDE_PATHS=
MEMEX_EXCLUDE_REMOTES=
MEMEX_INCLUDE_PATHS=

# Writing this marker in a session excludes it entirely.
MEMEX_OPTOUT_MARKER=#memex-off

# Redaction: extra patterns (regular expressions), and e-mail addresses.
MEMEX_REDACT_EXTRA=
MEMEX_REDACT_EMAILS=0

# Interim texts from the agent shorter than this are dropped
# ("let me look at the file…"). Final answers are always kept.
MEMEX_INTERIM_MIN_CHARS=280
# A longer message is truncated in its middle; a longer segment is split.
MEMEX_MAX_MESSAGE_CHARS=6000
MEMEX_MAX_SEGMENT_CHARS=40000


# ══ Host: link to the server ═════════════════════════════════════════════

# SSH address of the server, for example memex@my-server (Tailscale or public name).
#   empty: offline, the segments wait in the outbox
#   local: the server is on this machine (trial, or all-in-one installation)
MEMEX_SERVER_SSH=
# Value of MEMEX_HOME on the server.
MEMEX_SERVER_HOME=/srv/memex
# The ssh command to use.
MEMEX_SSH_CMD=ssh
# Options passed to ssh. The installer adds the key dedicated to memex.
MEMEX_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=6"
# Maximum duration of one exchange with the server, in seconds.
MEMEX_NET_TIMEOUT_S=60

# Working directory of memex on this machine: state, outbox, copy of the wiki.
MEMEX_DATA_DIR=~/.local/share/memex

# Maximum size of what the session-start hook injects into a session. Keep it
# above MEMEX_LIVING_PAGE_CHARS by a good third, so that a living page within
# its limit is injected whole, with the list of related pages.
MEMEX_HOOK_MAX_CHARS=8000
# Under the project's page, the hook lists the pages linked with the project in
# either direction (path and one-line summary, not their content). This is the
# most it lists; 0 lists none.
MEMEX_HOOK_RELATED=8
# The session-start hook skips its synchronisation when the last one is less
# than this many seconds old.
MEMEX_SYNC_MIN_INTERVAL_S=90

# Fetch the server's latest backup every day, and keep this many of them.
MEMEX_BACKUP_PULL=1
MEMEX_BACKUP_KEEP=7


# ══ Server ═══════════════════════════════════════════════════════════════

# Root of everything memex owns on the server.
MEMEX_HOME=/srv/memex

# Directory of the Obsidian vault, synchronised by the LiveSync client. Empty: no vault.
MEMEX_VAULT_DIR=

# Which harness runs the agents: hermes, claude or codex.
MEMEX_AGENT=hermes
# Model to use, if you want to force one (otherwise the harness's own).
MEMEX_AGENT_MODEL=
# For another harness, or to change the options: one shell command per
# permission level. It receives MEMEX_PROMPT_FILE, MEMEX_OUT_FILE, MEMEX_MODEL,
# MEMEX_ROLE (extract, integrate, weave, diagnose, links, apply or probe) and
# MEMEX_LANG (the language of the wiki).
MEMEX_AGENT_EXTRACT_CMD=
MEMEX_AGENT_READ_CMD=
MEMEX_AGENT_EDIT_CMD=
# Maximum duration of one agent call, in seconds.
MEMEX_AGENT_TIMEOUT_S=900

# Sandbox around each agent call (bubblewrap): the whole system is read-only,
# except the working copy of the wiki and the harness's own state.
#   auto:  used if it works on this machine (default)
#   bwrap: required — the pipeline refuses to run without it
#   none:  disabled
MEMEX_SANDBOX=auto
# Directories of the account that the harness must be able to write to (relative
# to the home directory). Empty: .hermes, .claude, .codex, .cache, .config…
MEMEX_SANDBOX_RW=

# Directory of custom prompts (extract.md, integrate.md, weave.md,
# curate-diagnose.md, curate-links.md, curate-apply.md). Empty: the ones
# shipped with memex.
MEMEX_PROMPTS_DIR=

# Path of the memex-gate command that each device's SSH key is restricted to.
# Empty: the one found in the PATH, otherwise /usr/local/bin/memex-gate.
MEMEX_GATE_BIN=
# File the devices' SSH keys are written to. Empty: ~/.ssh/authorized_keys of
# the account that owns MEMEX_HOME.
MEMEX_AUTHORIZED_KEYS=

# Notification command: it receives the message on its standard input, and
# its title in MEMEX_SUBJECT. Example with Hermes and Telegram:
#   MEMEX_NOTIFY_CMD='hermes send --to telegram --subject "$MEMEX_SUBJECT" --file -'
MEMEX_NOTIFY_CMD=
# never | failures | changes | always
MEMEX_NOTIFY_LEVEL=changes

# A session in which you wrote less than this costs no agent call: journal only.
MEMEX_MIN_USER_CHARS=80
# Number of segments per run, and maximum duration of a run in seconds.
MEMEX_BATCH_MAX=25
MEMEX_RUN_BUDGET_S=2400
# After this many failures, a segment goes to quarantine.
MEMEX_MAX_RETRIES=3

# The weaver (links and cross-cutting pages) only wakes up once the wiki has this
# many pages, and creates a page for a concept mentioned in this many folders.
MEMEX_WEAVER=1
MEMEX_WEAVER_MIN_PAGES=12
MEMEX_WEAVER_MIN_FOLDERS=2

# The curator: actions proposed per review, and lifetime of an unanswered review.
MEMEX_CURATOR_MAX_ACTIONS=8
MEMEX_REVIEW_TTL_DAYS=10
# On each run the curator also checks the links of this many folders, one agent
# call each: those that changed first, then the ones checked longest ago. Each
# may add one action to the review. 0 turns the check off.
MEMEX_CURATOR_LINK_FOLDERS=4

# Pages stay condensed. A living page (the main page of a project or of a topic)
# is loaded whole at the start of a session: near the first length the archivist
# puts new detail in supplementary pages, and beyond it the curator proposes to
# condense the page. The second length is the limit of every other page.
MEMEX_LIVING_PAGE_CHARS=5000
MEMEX_MAX_PAGE_CHARS=12000

# Number of daily backups kept on the server.
MEMEX_SERVER_BACKUP_KEEP=14

# On the server, memex also captures its own Hermes conversations:
#   MEMEX_SERVER_SSH=local
#   MEMEX_SOURCES=hermes
#   MEMEX_DEVICE=server
#   MEMEX_DATA_DIR=/srv/memex/hostdata
# The server installer writes these four lines for you.

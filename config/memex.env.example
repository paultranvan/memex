# memex — configuration
#
# Un seul format pour l'hôte et pour le serveur : des lignes KEY=valeur.
#   hôte    : ~/.config/memex/memex.env
#   serveur : /etc/memex/memex.env
# Une variable d'environnement du même nom l'emporte sur ce fichier.
# Tout est facultatif : les valeurs ci-dessous sont les valeurs par défaut.

# ══ Commun ═══════════════════════════════════════════════════════════════

# Fuseau horaire des dates écrites dans le wiki (journal, fiches de décision).
MEMEX_TZ=Europe/Paris


# ══ Hôte : ce qui est capturé ════════════════════════════════════════════

# Nom de cette machine dans les condensés. Défaut : son nom d'hôte.
MEMEX_DEVICE=

# Sources à balayer : claude-code, codex, hermes (liste séparée par des virgules).
MEMEX_SOURCES=claude-code,codex

# Où chaque outil range ses sessions.
MEMEX_CLAUDE_PROJECTS_DIR=~/.claude/projects
MEMEX_CODEX_SESSIONS_DIR=~/.codex/sessions
MEMEX_HERMES_DB=~/.hermes/state.db
# Sessions Hermes à ignorer, selon leur origine (tâches planifiées, etc.).
MEMEX_HERMES_EXCLUDE_SOURCES=cron

# Une session est balayée quand elle est inactive depuis ce nombre de minutes.
# La fin d'une session Claude Code déclenche un balayage immédiat, sans attendre.
MEMEX_IDLE_MINUTES=10

# Ce qu'il ne faut jamais capturer. Motifs séparés par des virgules.
#   MEMEX_EXCLUDE_PATHS   : répertoires de travail (motifs de chemin, ~ accepté)
#   MEMEX_EXCLUDE_REMOTES : dépôts git, d'après leur adresse distante
#   MEMEX_INCLUDE_PATHS   : si renseigné, seuls ces répertoires sont capturés
# Un fichier vide `.memex-ignore` à la racine d'un projet l'exclut aussi.
# Exemple : MEMEX_EXCLUDE_PATHS=~/Work,~/dev/travail
#           MEMEX_EXCLUDE_REMOTES=*mon-employeur*,gitlab.entreprise.example/*
MEMEX_EXCLUDE_PATHS=
MEMEX_EXCLUDE_REMOTES=
MEMEX_INCLUDE_PATHS=

# Écrire ce marqueur dans une session l'exclut entièrement.
MEMEX_OPTOUT_MARKER=#memex-off

# Masquage : motifs supplémentaires (expressions régulières), et adresses e-mail.
MEMEX_REDACT_EXTRA=
MEMEX_REDACT_EMAILS=0

# Les textes intermédiaires de l'agent plus courts que cela sont écartés
# (« je regarde le fichier… »). Les réponses finales sont toujours gardées.
MEMEX_INTERIM_MIN_CHARS=280
# Un message plus long est tronqué en son milieu ; un condensé plus long est découpé.
MEMEX_MAX_MESSAGE_CHARS=6000
MEMEX_MAX_SEGMENT_CHARS=40000


# ══ Hôte : liaison avec le serveur ═══════════════════════════════════════

# Adresse SSH du serveur, par exemple memex@mon-vps (nom Tailscale ou public).
#   vide    : hors-ligne, les condensés attendent dans la boîte d'envoi
#   local   : le serveur est sur cette machine (essai, ou installation tout-en-un)
MEMEX_SERVER_SSH=
# Valeur de MEMEX_HOME sur le serveur.
MEMEX_SERVER_HOME=/srv/memex
# Options passées à ssh. L'installeur y ajoute la clé dédiée à memex.
MEMEX_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=6"

# Dossier de travail de memex sur cette machine : état, boîte d'envoi, copie du wiki.
MEMEX_DATA_DIR=~/.local/share/memex

# Taille maximale de ce que le hook de démarrage injecte dans une session.
MEMEX_HOOK_MAX_CHARS=6000

# Rapatrier chaque jour la dernière sauvegarde du serveur, et en garder ce nombre.
MEMEX_BACKUP_PULL=1
MEMEX_BACKUP_KEEP=7


# ══ Serveur ══════════════════════════════════════════════════════════════

# Racine de tout ce que memex possède sur le serveur.
MEMEX_HOME=/srv/memex

# Dossier du vault Obsidian, synchronisé par le client LiveSync. Vide : pas de vault.
MEMEX_VAULT_DIR=

# Quel harnais fait tourner les agents : hermes, claude ou codex.
MEMEX_AGENT=hermes
# Modèle à utiliser, si tu veux en imposer un (sinon celui du harnais).
MEMEX_AGENT_MODEL=
# Pour un autre harnais, ou pour changer les options : une commande shell par
# niveau de droits. Elle reçoit MEMEX_PROMPT_FILE, MEMEX_OUT_FILE et MEMEX_MODEL.
MEMEX_AGENT_EXTRACT_CMD=
MEMEX_AGENT_READ_CMD=
MEMEX_AGENT_EDIT_CMD=
# Durée maximale d'un appel à l'agent, en secondes.
MEMEX_AGENT_TIMEOUT_S=900

# Commande de notification : elle reçoit le message sur son entrée standard, et
# son titre dans MEMEX_SUBJECT. Exemple avec Hermes et Telegram :
#   MEMEX_NOTIFY_CMD='hermes send --to telegram --subject "$MEMEX_SUBJECT" --file -'
MEMEX_NOTIFY_CMD=
# never | failures | changes | always
MEMEX_NOTIFY_LEVEL=changes

# Une session où tu as écrit moins que cela ne coûte aucun appel : journal seulement.
MEMEX_MIN_USER_CHARS=80
# Nombre de condensés par passage, et durée maximale d'un passage en secondes.
MEMEX_BATCH_MAX=25
MEMEX_RUN_BUDGET_S=2400
# Après ce nombre d'échecs, un condensé part en quarantaine.
MEMEX_MAX_RETRIES=3

# Le tisseur (liens et pages transverses) ne se réveille qu'à partir de ce
# nombre de pages, et crée une page pour un concept cité dans ce nombre de dossiers.
MEMEX_TISSEUR=1
MEMEX_TISSEUR_MIN_PAGES=12
MEMEX_TISSEUR_MIN_DOSSIERS=2

# Le vérificateur : actions proposées par revue, et durée de vie d'une revue sans réponse.
MEMEX_VERIF_MAX_ACTIONS=8
MEMEX_REVIEW_TTL_DAYS=10

# Au-delà de cette longueur, une page est signalée au vérificateur.
MEMEX_MAX_PAGE_CHARS=24000

# Nombre de sauvegardes quotidiennes gardées sur le serveur.
MEMEX_SERVER_BACKUP_KEEP=14

# Sur le serveur, memex capture aussi ses propres discussions Hermes :
#   MEMEX_SERVER_SSH=local
#   MEMEX_SOURCES=hermes
#   MEMEX_DEVICE=serveur
#   MEMEX_DATA_DIR=/srv/memex/hostdata
# L'installeur du serveur écrit ces quatre lignes pour toi.
